# Container settings for Photolake. scripts/install.sh writes a real .env (mode 600) with random keys;
# this file only documents the options.

# Your user and group ids (files are written as you) and username (for /media/<user>).
PUID=1000
PGID=1000
HOST_USER=me
TZ=America/Denver

# Images. Published: ghcr.io/<owner>/photolake (GPU variant gets "-cuda" appended to the tag).
PHOTOLAKE_IMAGE=ghcr.io/OWNER/photolake
PHOTOLAKE_TAG=latest
PHOTOLAKE_MODELS_IMAGE=ghcr.io/OWNER/photolake-models
PHOTOLAKE_MODELS_TAG=latest
PHOTOLAKE_GPU=0                 # 1 = use compose.gpu.yml (NVIDIA)

# Object storage keys (random per install; never shared).
PHOTOLAKE_S3_ACCESS_KEY=change-me
PHOTOLAKE_S3_SECRET_KEY=change-me-too

# Where things live on this computer.
PHOTOLAKE_S3_DATA=/home/me/Photolake/storage
PHOTOLAKE_S3_LOGS=/home/me/Photolake/storage-logs
PHOTOLAKE_DATA=/home/me/Photolake/data
PHOTOLAKE_CONFIG_DIR=/home/me/Photolake/config
PHOTOLAKE_IMPORT_DIR=/home/me/Photolake/import

# Network: 127.0.0.1 = this computer only; 0.0.0.0 = also your home Wi-Fi (photolake-ctl wifi on).
PHOTOLAKE_LISTEN=127.0.0.1
PHOTOLAKE_PORT=7878
PHOTOLAKE_ALLOWED_HOSTS=        # extra host names, comma-separated (IPs and *.ts.net are always allowed)

# unless-stopped = start at boot; no = only when you run photolake-ctl start.
PHOTOLAKE_RESTART=unless-stopped

# Tailscale (photolake-ctl tailscale on).
PHOTOLAKE_TAILSCALE=0
TS_AUTHKEY=
